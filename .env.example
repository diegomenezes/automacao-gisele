# Google APIs (service account JSON)
GOOGLE_APPLICATION_CREDENTIALS=./credentials.json
# Calendário compartilhado com a service account (captações CAPTAÇÃO)
GOOGLE_CALENDAR_ID=primary
# Google Workspace: e-mail do usuário a impersonar (domain-wide delegation)
# Ex.: gisele@therockdigital.com.br — obrigatório se o share só permitir livre/ocupado
GOOGLE_IMPERSONATE_USER=

# Template Copy global (fallback se especialista não tem template_copy_id)
TEMPLATE_COPY_ID=

# OpenAI (or compatible API)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Evolution API (WhatsApp)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=default
WHATSAPP_GROUP_ID=

# Database
DATABASE_URL=./data/agent.db

# Scheduler
CRON_SCHEDULE=0 8 * * *
CAPTURE_WINDOW_DAYS=15
TIMEZONE=America/Sao_Paulo

# Admin panel
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-me-to-random-string
ADMIN_PORT=3000

# Server
PORT=3000
NODE_ENV=production
